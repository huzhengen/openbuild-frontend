{
  "github": {
    "release": true,
    "releaseName": "Release ${version}",
    "releaseNotes": "npx auto-changelog --stdout --commit-limit false -u"
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:release": "echo 'Release completed!'"
  }
}